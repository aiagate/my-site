{
	"type": "module",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": ">=22.18.0",
		"pnpm": ">=11.22.0"
	},
	"scripts": {
		"build": "node tools/build.ts && cd site && cf build && cd ../api && cf build",
		"new:post": "node tools/new-post.ts",
		"db:create": "cf d1 create --name my-site-likes",
		"db:migrate": "cf d1 migrations apply 9f784723-b63b-4a28-b476-70014e5146fb --dir ./migrations",
		"deploy": "pnpm build && node tools/check-public-manifest.ts && pnpm deploy:api && node tools/smoke-api.ts && pnpm deploy:static",
		"deploy:api": "cd api && cf deploy --prebuilt",
		"deploy:static": "cd site && cf deploy --prebuilt",
		"dev": "pnpm build && node tools/dev.ts",
		"start": "pnpm dev",
		"test": "pnpm build && vitest run",
		"test:watch": "pnpm build && vitest",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check . && tsc --noEmit",
		"check:fix": "biome check --write ."
	},
	"dependencies": {
		"date-fns": "^4.4.0",
		"date-fns-tz": "^3.2.0",
		"gray-matter": "^4.0.3",
		"hono": "^4.13.3",
		"marked": "^18.0.9",
		"sanitize-html": "^2.17.7",
		"zod": "^4.4.3",
		"zod-matter": "^0.1.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.8",
		"@cloudflare/vitest-plugin": "^1.0.0",
		"@cloudflare/workers-types": "^5.20261004.1",
		"@types/node": "^22.15.17",
		"@types/sanitize-html": "^2.16.1",
		"cf": "1.0.0-beta.12",
		"miniflare": "5.20260820.0-alpha",
		"typescript": "^5.8.3",
		"vitest": "^4.1.11",
		"wrangler": "^4.147.0"
	}
}
