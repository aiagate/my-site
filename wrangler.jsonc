{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "my-site",
	"compatibility_date": "2026-08-17",
	"main": "src/worker.ts",
	"assets": {
		// The path to the directory containing the `index.html` file to be served at `/`.
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "LIKES",
			"database_name": "my-site-likes",
			"database_id": "9f784723-b63b-4a28-b476-70014e5146fb",
			"migrations_dir": "migrations"
		}
	],
	"ratelimits": [
		{
			"name": "LIKE_RATE_LIMIT",
			"namespace_id": "78001631",
			"simple": {
				"limit": 30,
				"period": 10
			}
		}
	],
	"observability": {
		"enabled": true
	}
}
