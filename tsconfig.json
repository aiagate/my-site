{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["@cloudflare/workers-types", "node"]
	},
	"include": [
		"src/**/*.ts",
		"api/**/*.ts",
		"tools/**/*.ts",
		"vitest.config.ts",
		"site/**/*.ts"
	]
}
